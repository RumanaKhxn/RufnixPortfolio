# Rufnix Studio Server Configuration
PORT=5000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI:
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/rufnix?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rufnix?retryWrites=true&w=majority
